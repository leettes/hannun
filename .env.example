APP_NAME=hannun
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Seoul

# 접근 제어
# 쉼표로 구분한 IP/CIDR (예: 203.0.113.10,10.0.0.0/16). 비워 두면 APP_ENV=local 에서만 전체 허용, 그 외 환경은 전체 차단
ALLOWED_IPS=
# 앞단 프록시/ALB 대역. 여기 속한 주소에서 온 요청만 X-Forwarded-For 를 신뢰
TRUSTED_PROXIES=
# 미사용 시 자동 로그아웃(분)
SESSION_IDLE_MINUTES=120
# HTTPS 운영 환경에서는 true
SESSION_SECURE_COOKIE=false

# 외부 알림 수신 (docs/ALERTS.md)
# Uptime Kuma Webhook 의 Authorization: Bearer 토큰. 비워 두면 수신 거부. 생성: php -r 'echo bin2hex(random_bytes(24));'
ALERT_WEBHOOK_TOKEN=
# CloudWatch 알람을 보내는 SNS 토픽 ARN (쉼표 구분). 비워 두면 수신 거부
SNS_TOPIC_ARNS=

# Uptime Kuma 지표 수집 (bin/cron.php, 1분마다). Uptime Kuma 설정 → API 키에서 발급
UPTIME_KUMA_URL=
UPTIME_KUMA_API_KEY=

# 장애 문자 알림 (알리고). 비워 두면 발송하지 않고 기록만 한다. 발신번호·발송 서버 IP 는 알리고에 사전 등록
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=
# true 면 알리고 테스트 모드 (실제 발송·과금 없음)
ALIGO_TESTMODE=false
# 문자에 넣을 대시보드 주소 (예: https://monitor.example.com). 비우면 생략
APP_URL=

# SQLite DB 파일 (프로젝트 루트 기준 상대 경로 또는 절대 경로)
DB_DATABASE=storage/database.sqlite

# docker compose 포트 (호스트). 8080은 이 맥의 다른 nginx가 사용 중
APP_PORT=8081

# EC2·RDS 화면 표시 (AWS 연동 단계 전까지 false)
AWS_RESOURCES=false
