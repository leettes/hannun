{
    "name": "dreamdive/hannun",
    "description": "한눈 (Hannun) - 통합 모니터링 대시보드",
    "type": "project",
    "license": "proprietary",
    "require": {
        "ext-pdo_sqlite": "*",
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "config:export": "php bin/config.php export",
        "config:import": "php bin/config.php import",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t public"
        ],
        "test": "phpunit",
        "migrate": "php bin/migrate.php",
        "user:create": "php bin/create-user.php",
        "seed:sample": "php bin/seed-sample.php"
    },
    "config": {
        "sort-packages": true
    }
}
